# ---------- Frontend (deeper ignores beyond frontend/.gitignore) ----------
# frontend/.gitignore already covers most, but root guard for safety
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/.umi/
frontend/.umi-production/
frontend/_roadhog-api-doc
frontend/screenshot/
frontend/.firebase/
frontend/.eslintcache
frontend/src/utils/request-temp.js

# ---------- Backend (deeper ignores beyond backend/.gitignore) ----------
# backend/.gitignore already covers most
backend/logs/
backend/statics/             # 老 UmiJS 构建产物,2026-10-14 已 git rm -r;main.py 不再挂载
backend/docs/                # 另一份孤儿前端产物,2026-10-14 已 git rm -r;main.py 不挂载
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/.mypy_cache/
backend/.venv/
backend/venv/

# ---------- Coverage / build artifacts (generic) ----------
coverage/
*.lcov
htmlcov/
.tox/
build/
dist/
*.egg-info/

# ---------- Claude Code personal (never commit) ----------
.claude/settings.local.json
.claude/memory/
.claude/agents/local/
